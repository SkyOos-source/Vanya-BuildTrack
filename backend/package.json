{
  "name": "@buildtrack/backend",
  "private": true,
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run routes && npm run prisma:deploy && tsx watch src/index.ts",
    "routes": "tsoa routes -c tsoa.json",
    "spec": "tsoa spec -c tsoa.json",
    "generate": "npm run spec && npm run routes",
    "build": "npm run prisma:generate && npm run generate && tsc -p tsconfig.json",
    "build:postgres": "npm run prisma:generate:postgres && npm run generate && tsc -p tsconfig.json",
    "start": "npm run prisma:deploy && node dist/index.js",
    "start:postgres": "npm run prisma:deploy:postgres && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:postgres": "prisma generate --schema prisma/postgresql/schema.prisma",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:postgres": "prisma migrate dev --schema prisma/postgresql/schema.prisma",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:deploy:postgres": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "prisma:studio": "prisma studio",
    "prisma:studio:postgres": "prisma studio --schema prisma/postgresql/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@types/web-push": "^3.6.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "tsoa": "^7.0.0-alpha.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.19.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
