DATABASE_URL="postgresql://buildtrack:buildtrack@localhost:5432/buildtrack?schema=public"
PORT=3001
# Owner accounts are created through the one-time browser setup using a code printed in server logs.
# Optional. If the keys are omitted, a persistent local VAPID key pair is generated automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Set this to a monitored contact address in production.
VAPID_SUBJECT=mailto:admin@example.com
