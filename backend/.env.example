# Local development stores data in a SQLite database beside this schema.
DATABASE_URL=file:./local.db
PORT=3001
# Owner accounts are created through the one-time browser setup using a code printed in server logs.
# Optional. If the keys are omitted, a persistent local VAPID key pair is generated automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Set this to a monitored contact address in production.
VAPID_SUBJECT=mailto:admin@example.com
# Enable SMS-based two-step sign-in only after configuring Twilio Verify.
MFA_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Cloudflare R2 object storage for uploaded images.
# Use an R2 API token with object read/write permission for the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket/custom-domain base URL, for example https://images.example.com
R2_PUBLIC_BASE_URL=
