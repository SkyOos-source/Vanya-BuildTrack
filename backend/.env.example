# Local development connects to the loopback-only PostgreSQL service in docker-compose.local.yml.
DATABASE_URL=postgresql://buildtrack:buildtrack-local-dev-only@localhost:5433/buildtrack_local?schema=public
PORT=3001
# Owner accounts are created through the one-time browser setup using a code printed in server logs.
# Optional. If the keys are omitted, a persistent local VAPID key pair is generated automatically.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Set this to a monitored contact address in production.
VAPID_SUBJECT=mailto:admin@example.com
# Enable SMS-based two-step sign-in only after configuring Twilio Verify.
MFA_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
