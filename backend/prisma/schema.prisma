generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/buildtrack.db"
}

model AppState {
  id      String @id
  payload String
}

model RefreshToken {
  tokenHash String   @id
  userJson  String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ClientLoginQuota {
  email      String @id
  day        String
  loginCount Int
}
