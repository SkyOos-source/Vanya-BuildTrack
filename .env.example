POSTGRES_DB=buildtrack
POSTGRES_USER=buildtrack
# Replace with a unique random hexadecimal secret. For example: openssl rand -hex 32
POSTGRES_PASSWORD=
# Optional: self-hosted Nominatim-compatible reverse endpoint, e.g. https://geocoder.example.com/reverse
VITE_REVERSE_GEOCODER_URL=

# Optional production settings
MFA_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Cloudflare R2 object storage (required for image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
